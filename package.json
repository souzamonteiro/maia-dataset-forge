{
  "name": "maia-dataset-forge",
  "version": "0.1.0",
  "description": "Reproducible academic corpus and SFT dataset builder for Maia Academic",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node src/cli.js",
    "discover": "node src/cli.js discover",
    "download": "node src/cli.js download",
    "extract": "node src/cli.js extract",
    "dedupe": "node src/cli.js dedupe",
    "stats": "node src/cli.js stats",
    "generate": "node src/cli.js generate",
    "validate": "node src/cli.js validate",
    "validation:timings": "node scripts/validation-timings.js",
    "translations:prepare": "node src/cli.js translations prepare",
    "translations:revise": "node src/cli.js translations revise",
    "translations:audit-languages": ".venv-language-audit/bin/python scripts/audit-source-languages.py",
    "translations:generate": "node src/cli.js translations generate",
    "translations:check": "node src/cli.js translations check",
    "translations:review": "node src/cli.js translations review",
    "translations:stats": "node src/cli.js translations stats",
    "translations:export": "node src/cli.js translations export",
    "export": "node src/cli.js export",
    "pipeline": "node src/cli.js pipeline",
    "test": "node --test",
    "cleanup": "node src/cli.js cleanup",
    "check": "node src/cli.js check",
    "benchmark": "node src/cli.js benchmark",
    "prepare-benchmark": "node src/cli.js prepare-benchmark",
    "benchmark:cost": "node src/cli.js benchmark-cost",
    "batch:pilot": "node src/cli.js batch-pilot",
    "prepare:reviewed": "node src/cli.js prepare-reviewed",
    "corpus:audit": "node src/cli.js corpus",
    "corpus:collect": "node src/cli.js corpus --collect",
    "batch:ten": "flock -n data/logs/batch-pilot.lock node scripts/batch-ten.js",
    "benchmark:generators": "flock -n data/logs/batch-pilot.lock node scripts/compare-generators.js",
    "benchmark:editorial": "flock -n data/logs/batch-pilot.lock node scripts/editorial-regression.js",
    "benchmark:validator": "flock -n data/logs/batch-pilot.lock node scripts/evaluate-validator.js",
    "benchmark:validators": "flock -n data/logs/batch-pilot.lock node scripts/compare-validators.js"
  },
  "dependencies": {
    "undici": "^7.30.0"
  }
}
